[Unit]
Description=Mayara radar server (HALO, mit Steuerung + ARPA fuer SUKI Radar Station)
After=network-online.target signalk.service
Wants=network-online.target

[Service]
User=admin
WorkingDirectory=/home/admin/mayara
ExecStart=/home/admin/mayara/mayara-server -b navico -i eth0 --no-mdns -t arpa -n ws:127.0.0.1:3000 -p 6502 --no-telemetry
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
